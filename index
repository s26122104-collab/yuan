    <!-- html2canvas CDN (迷因截圖下載) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <style>
        /* ==========================================
           COLOR PALETTE DEFINITION & RESET
           ========================================== */
        :root {
            --isabelline: #F4F0EC;      /* 主背景與奶油卡片底色 */
            --vandyke: #664228;          /* 復古深棕邊框、文字與陰影 */
            --pink-lavender: #D9AFCA;  /* 主視覺粉紫蘭點綴色 */
            --reseda-green: #697D58;   /* 復古灰綠點綴色 */
            --butter-yellow: #EFDE9C;  /* Week 3 點綴奶油黃 */
           
            /* 導出衍生色 */
            --vandyke-light: #52341e;
            --locked-bg: #DCD7D2;
            --locked-text: #8C827A;
            --card-bg: #FCFBF9;

            --retro-black: #1A1A1A;
        }

        /* 已修正：原本誤寫為 "- {"，已改回正確的萬用選擇器 "* {" */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
        }

        body {
            background-color: var(--isabelline);
            background-image:
                radial-gradient(var(--pink-lavender) 18%, transparent 19%),
                radial-gradient(var(--reseda-green) 18%, transparent 19%);
            background-size: 50px 50px;
            background-position: 0 0, 25px 25px;
            font-family: 'Noto Sans TC', sans-serif;
            color: var(--vandyke);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
            overflow-x: hidden;
            position: relative;
        }

        /* 復古紙張質感覆蓋層 */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(135deg, rgba(244, 240, 236, 0.4), rgba(105, 125, 88, 0.1));
            pointer-events: none;
            z-index: 10;
        }

        /* 主容器 */
        .container {
            max-width: 1080px;
            width: 100%;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            z-index: 1;
        }

        /* ==========================================
           HEADER & PROFILE SECTION
           ========================================== */
        .profile-card {
            background: var(--card-bg);
            border: 4px solid var(--vandyke);
            box-shadow: 10px 10px 0px var(--vandyke);
            padding: 30px;
            border-radius: 18px;
            text-align: center;
            margin-bottom: 40px;
            width: 100%;
            max-width: 520px;
            position: relative;
            transform: rotate(-1deg);
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .profile-card:hover {
            transform: rotate(0deg) scale(1.02);
        }

        .avatar-wrapper {
            position: relative;
            width: 160px;
            height: 160px;
            margin: 0 auto 20px;
            background: #ffffff;
            padding: 10px 10px 28px 10px;
            border: 3.5px solid var(--vandyke);
            box-shadow: 6px 6px 0px rgba(102, 66, 40, 0.25);
            transform: rotate(2.5deg);
            transition: all 0.4s ease;
        }

        .profile-card:hover .avatar-wrapper {
            transform: rotate(-3deg) scale(1.08);
        }

        .avatar-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border: 2px solid var(--vandyke);
            filter: contrast(105%) sepia(15%);
        }

        .badge-sticker {
            position: absolute;
            top: -15px;
            right: -25px;
            background: var(--pink-lavender);
            color: var(--vandyke);
            font-family: 'Changa One', cursive;
            font-size: 14px;
            padding: 6px 14px;
            border: 3px solid var(--vandyke);
            box-shadow: 4px 4px 0px var(--vandyke);
            transform: rotate(12deg);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: bold;
            z-index: 2;
        }

        .profile-name {
            font-family: 'Changa One', 'Noto Sans TC', sans-serif;
            font-size: 2.5rem;
            color: var(--vandyke);
            text-shadow: 2px 2px 0px var(--pink-lavender);
            letter-spacing: 1.5px;
            margin-bottom: 8px;
            line-height: 1.2;
        }

        .profile-subtitle {
            font-family: 'Press Start 2P', monospace;
            font-size: 0.72rem;
            color: #ffffff;
            background: var(--reseda-green);
            display: inline-block;
            padding: 8px 14px;
            border-radius: 20px;
            border: 2.5px solid var(--vandyke);
            box-shadow: 3px 3px 0px var(--vandyke);
            font-weight: bold;
        }

        .quest-status {
            margin-top: 20px;
            font-size: 0.85rem;
            font-weight: 800;
            color: var(--vandyke);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

        .progress-bar {
            width: 130px;
            height: 16px;
            background: #e2dad3;
            border: 2.5px solid var(--vandyke);
            border-radius: 10px;
            overflow: hidden;
            position: relative;
        }

        .progress-fill {
            width: 37.5%; /* 已更新：6 / 16 = 37.5% */
            height: 100%;
            background: linear-gradient(90deg, var(--pink-lavender), var(--reseda-green), var(--butter-yellow));
            border-right: 2px solid var(--vandyke);
            transition: width 0.5s ease;
        }

        /* ==========================================
           GRID MENU SECTION
           ========================================== */
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            width: 100%;
        }

        .menu-btn {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 115px;
            padding: 16px;
            border-radius: 14px;
            border: 3.5px solid var(--vandyke);
            text-decoration: none;
            color: var(--vandyke);
            font-weight: 800;
            transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            overflow: hidden;
        }

        .btn-tag {
            font-family: 'Press Start 2P', monospace;
            font-size: 0.65rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            width: 100%;
        }

        .btn-title {
            font-size: 1.05rem;
            line-height: 1.35;
            z-index: 1;
            word-break: break-word;
        }

        .menu-btn.unlocked {
            box-shadow: 6px 6px 0px var(--vandyke);
            cursor: pointer;
        }

        .menu-btn.unlocked.btn-1 { background: #fbf0f7; }
        .menu-btn.unlocked.btn-1 .btn-tag { color: #8e4f7a; }

        .menu-btn.unlocked.btn-2 { background: #f0f4ee; }
        .menu-btn.unlocked.btn-2 .btn-tag { color: var(--reseda-green); }

        .menu-btn.unlocked.btn-3 { background: #fffdf2; }
        .menu-btn.unlocked.btn-3 .btn-tag { color: #b89314; }

        /* Stage 04 專屬配色 */
        .menu-btn.unlocked.btn-4 { background: #f3f8f2; }
        .menu-btn.unlocked.btn-4 .btn-tag { color: #4a6839; }

        /* Stage 05 專屬配色 */
        .menu-btn.unlocked.btn-5 { background: #fff4ed; }
        .menu-btn.unlocked.btn-5 .btn-tag { color: #c45a27; }

        /* Stage 06 專屬莫蘭迪配色 */
        .menu-btn.unlocked.btn-6 { background: #F3EFEA; }
        .menu-btn.unlocked.btn-6 .btn-tag { color: #738779; }

        .menu-btn.unlocked:hover {
            transform: translate(-4px, -4px);
            box-shadow: 10px 10px 0px var(--vandyke);
        }

        .menu-btn.unlocked.btn-1:hover { background: var(--pink-lavender); color: var(--vandyke); }
        .menu-btn.unlocked.btn-2:hover { background: var(--reseda-green); color: var(--isabelline); }
        .menu-btn.unlocked.btn-2:hover .btn-tag { color: var(--isabelline); }
        .menu-btn.unlocked.btn-3:hover { background: var(--butter-yellow); color: var(--vandyke); }
       
        /* Stage 04 Hover 動態懸浮配色 */
        .menu-btn.unlocked.btn-4:hover { background: #92b07b; color: #ffffff; }
        .menu-btn.unlocked.btn-4:hover .btn-tag { color: #ffffff; }

        /* Stage 05 Hover 動態懸浮配色 */
        .menu-btn.unlocked.btn-5:hover { background: #e07a48; color: #ffffff; }
        .menu-btn.unlocked.btn-5:hover .btn-tag { color: #ffffff; }

        /* Stage 06 Hover 莫蘭迪鼠尾草綠 */
        .menu-btn.unlocked.btn-6:hover { background: #8FA395; color: #ffffff; }
        .menu-btn.unlocked.btn-6:hover .btn-tag { color: #ffffff; }

        .menu-btn.unlocked:active {
            transform: translate(2px, 2px);
            box-shadow: 2px 2px 0px var(--vandyke);
        }

        .menu-btn.unlocked::after {
            content: "GO! ➔";
            position: absolute;
            bottom: 10px;
            right: 12px;
            font-family: 'Changa One', sans-serif;
            font-size: 0.95rem;
            opacity: 0;
            transform: translateX(-10px);
            transition: all 0.25s ease;
        }

        .menu-btn.unlocked:hover::after {
            opacity: 1;
            transform: translateX(0);
        }

        .menu-btn.locked {
            background: var(--locked-bg);
            border-color: var(--vandyke);
            color: var(--locked-text);
            box-shadow: 4px 4px 0px var(--vandyke);
            cursor: not-allowed;
            opacity: 0.82;
        }

        .menu-btn.locked .btn-tag { color: #786f67; }
        .menu-btn.locked .lock-icon { font-size: 1.25rem; transition: transform 0.3s ease; }

        .menu-btn.locked:hover {
            transform: translateY(-2px);
            background: #d0c9c2;
            box-shadow: 6px 6px 0px var(--vandyke);
            color: var(--vandyke);
        }

        .menu-btn.locked:hover .lock-icon {
            animation: lockShake 0.4s ease-in-out infinite alternate;
        }

        .menu-btn.locked::before {
            content: "LOCKED";
            position: absolute;
            bottom: 8px;
            right: 10px;
            font-family: 'Press Start 2P', monospace;
            font-size: 0.55rem;
            color: var(--vandyke);
            opacity: 0.5;
        }

        @keyframes lockShake {
            0% { transform: rotate(-12deg) scale(1.15); }
            100% { transform: rotate(12deg) scale(1.15); }
        }

        /* ==========================================
           MEME GENERATOR MODAL STYLING
           ========================================== */
        .font-retro-title { font-family: 'Bebas Neue', cursive; letter-spacing: 2px; }
        .font-meme { font-family: 'Anton', 'Impact', sans-serif; text-transform: uppercase; letter-spacing: 1px; }

        .retro-box-shadow { box-shadow: 6px 6px 0px var(--retro-black); }
        .retro-button-shadow {
            box-shadow: 4px 4px 0px var(--retro-black);
            transition: all 0.15s ease-in-out;
        }
        .retro-button-shadow:hover {
            transform: translate(-2px, -2px);
            box-shadow: 6px 6px 0px var(--retro-black);
        }
        .retro-button-shadow:active {
            transform: translate(2px, 2px);
            box-shadow: 2px 2px 0px var(--retro-black);
        }

        .meme-text-stroke {
            color: #FFFFFF;
            -webkit-text-stroke: 2px var(--retro-black);
            text-shadow:
                3px 3px 0 var(--retro-black),
                -3px -3px 0 var(--retro-black),
                3px -3px 0 var(--retro-black),
                -3px 3px 0 var(--retro-black),
                0px 3px 0 var(--retro-black),
                0px -3px 0 var(--retro-black),
                3px 0px 0 var(--retro-black),
                -3px 0px 0 var(--retro-black),
                4px 4px 8px rgba(0,0,0,0.6);
            line-height: 1.1;
            word-break: break-word;
        }

        input[type=range] {
            -webkit-appearance: none;
            width: 100%;
            background: #E5E7EB;
            height: 10px;
            border-radius: 5px;
            border: 2px solid var(--retro-black);
        }
        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 22px;
            width: 22px;
            border-radius: 50%;
            background: var(--butter-yellow);
            border: 2px solid var(--retro-black);
            cursor: pointer;
            box-shadow: 2px 2px 0px var(--retro-black);
        }

        /* ==========================================
           STAGE 06: PICKONE MORANDI MODAL STYLING
           ========================================== */
        .aspect-square-box {
            aspect-ratio: 1 / 1;
        }
        .morandi-shadow {
            box-shadow: 0 10px 30px -5px rgba(74, 73, 71, 0.08), 0 4px 12px -2px rgba(74, 73, 71, 0.04);
        }
        .bar-transition {
            transition: width 0.85s cubic-bezier(0.22, 1, 0.36, 1);
        }
        #pickone-modal input {
            user-select: text;
        }

        @media (max-width: 900px) {
            .menu-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
        }

        @media (max-width: 540px) {
            body { padding: 20px 12px; }
            .profile-card { padding: 20px 15px; margin-bottom: 25px; }
            .profile-name { font-size: 1.9rem; }
            .menu-grid { grid-template-columns: 1fr; gap: 12px; }
            .menu-btn { min-height: 90px; padding: 14px; }
            .btn-title { font-size: 1rem; }
        }
    </style>
</head>
<body>

    <!-- 作品集主畫面 -->
    <div class="container">
        <!-- 畫面正中央大頭貼與名字區塊 -->
        <header class="profile-card">
            <div class="avatar-wrapper">
                <span class="badge-sticker">PLAYER 1</span>
