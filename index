<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>我的網頁程式作品集 | Vintage Quest Portfolio</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Bebas+Neue&family=Changa+One:ital@0;1&family=Montserrat:wght@600;800;900&family=Noto+Sans+TC:wght@500;800;900&family=Press+Start+2P&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- html2canvas CDN (迷因截圖下載) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <style>
        /* ==========================================
           COLOR PALETTE DEFINITION & RESET
           ========================================== */
        :root {
            --isabelline: #F4F0EC;      /* 主背景與奶油卡片底色 */
            --vandyke: #664228;          /* 復古深棕邊框、文字與陰影 */
            --pink-lavender: #D9AFCA;  /* 主視覺粉紫蘭點綴色 */
            --reseda-green: #697D58;   /* 復古灰綠點綴色 */
            --butter-yellow: #EFDE9C;  /* Week 3 點綴奶油黃 */
            
            /* 導出衍生色 */
            --vandyke-light: #52341e;
            --locked-bg: #DCD7D2;
            --locked-text: #8C827A;
            --card-bg: #FCFBF9;

            --retro-black: #1A1A1A;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
        }

        body {
            background-color: var(--isabelline);
            background-image: 
                radial-gradient(var(--pink-lavender) 18%, transparent 19%),
                radial-gradient(var(--reseda-green) 18%, transparent 19%);
            background-size: 50px 50px;
            background-position: 0 0, 25px 25px;
            font-family: 'Noto Sans TC', sans-serif;
            color: var(--vandyke);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
            overflow-x: hidden;
            position: relative;
        }

        /* 復古紙張質感覆蓋層 */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(135deg, rgba(244, 240, 236, 0.4), rgba(105, 125, 88, 0.1));
            pointer-events: none;
            z-index: 10;
        }

        /* 主容器 */
        .container {
            max-width: 1080px;
            width: 100%;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            z-index: 1;
        }

        /* ==========================================
           HEADER & PROFILE SECTION
           ========================================== */
        .profile-card {
            background: var(--card-bg);
            border: 4px solid var(--vandyke);
            box-shadow: 10px 10px 0px var(--vandyke);
            padding: 30px;
            border-radius: 18px;
            text-align: center;
            margin-bottom: 40px;
            width: 100%;
            max-width: 520px;
            position: relative;
            transform: rotate(-1deg);
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .profile-card:hover {
            transform: rotate(0deg) scale(1.02);
        }

        .avatar-wrapper {
            position: relative;
            width: 160px;
            height: 160px;
            margin: 0 auto 20px;
            background: #ffffff;
            padding: 10px 10px 28px 10px;
            border: 3.5px solid var(--vandyke);
            box-shadow: 6px 6px 0px rgba(102, 66, 40, 0.25);
            transform: rotate(2.5deg);
            transition: all 0.4s ease;
        }

        .profile-card:hover .avatar-wrapper {
            transform: rotate(-3deg) scale(1.08);
        }

        .avatar-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border: 2px solid var(--vandyke);
            filter: contrast(105%) sepia(15%);
        }

        .badge-sticker {
            position: absolute;
            top: -15px;
            right: -25px;
            background: var(--pink-lavender);
            color: var(--vandyke);
            font-family: 'Changa One', cursive;
            font-size: 14px;
            padding: 6px 14px;
            border: 3px solid var(--vandyke);
            box-shadow: 4px 4px 0px var(--vandyke);
            transform: rotate(12deg);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: bold;
            z-index: 2;
        }

        .profile-name {
            font-family: 'Changa One', 'Noto Sans TC', sans-serif;
            font-size: 2.5rem;
            color: var(--vandyke);
            text-shadow: 2px 2px 0px var(--pink-lavender);
            letter-spacing: 1.5px;
            margin-bottom: 8px;
            line-height: 1.2;
        }

        .profile-subtitle {
            font-family: 'Press Start 2P', monospace;
            font-size: 0.72rem;
            color: #ffffff;
            background: var(--reseda-green);
            display: inline-block;
            padding: 8px 14px;
            border-radius: 20px;
            border: 2.5px solid var(--vandyke);
            box-shadow: 3px 3px 0px var(--vandyke);
            font-weight: bold;
        }

        .quest-status {
            margin-top: 20px;
            font-size: 0.85rem;
            font-weight: 800;
            color: var(--vandyke);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

        .progress-bar {
            width: 130px;
            height: 16px;
            background: #e2dad3;
            border: 2.5px solid var(--vandyke);
            border-radius: 10px;
            overflow: hidden;
            position: relative;
        }

        .progress-fill {
            width: 18.75%; /* 3/16 = 18.75% */
            height: 100%;
            background: linear-gradient(90deg, var(--pink-lavender), var(--reseda-green), var(--butter-yellow));
            border-right: 2px solid var(--vandyke);
        }

        /* ==========================================
           GRID MENU SECTION
           ========================================== */
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            width: 100%;
        }

        .menu-btn {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 115px;
            padding: 16px;
            border-radius: 14px;
            border: 3.5px solid var(--vandyke);
            text-decoration: none;
            color: var(--vandyke);
            font-weight: 800;
            transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            overflow: hidden;
        }

        .btn-tag {
            font-family: 'Press Start 2P', monospace;
            font-size: 0.65rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .btn-title {
            font-size: 1.05rem;
            line-height: 1.35;
            z-index: 1;
            word-break: break-word;
        }

        .menu-btn.unlocked {
            box-shadow: 6px 6px 0px var(--vandyke);
            cursor: pointer;
        }

        .menu-btn.unlocked.btn-1 { background: #fbf0f7; }
        .menu-btn.unlocked.btn-1 .btn-tag { color: #8e4f7a; }

        .menu-btn.unlocked.btn-2 { background: #f0f4ee; }
        .menu-btn.unlocked.btn-2 .btn-tag { color: var(--reseda-green); }

        .menu-btn.unlocked.btn-3 { background: #fffdf2; }
        .menu-btn.unlocked.btn-3 .btn-tag { color: #b89314; }

        .menu-btn.unlocked:hover {
            transform: translate(-4px, -4px);
            box-shadow: 10px 10px 0px var(--vandyke);
        }

        .menu-btn.unlocked.btn-1:hover { background: var(--pink-lavender); color: var(--vandyke); }
        .menu-btn.unlocked.btn-2:hover { background: var(--reseda-green); color: var(--isabelline); }
        .menu-btn.unlocked.btn-2:hover .btn-tag { color: var(--isabelline); }
        .menu-btn.unlocked.btn-3:hover { background: var(--butter-yellow); color: var(--vandyke); }

        .menu-btn.unlocked:active {
            transform: translate(2px, 2px);
            box-shadow: 2px 2px 0px var(--vandyke);
        }

        .menu-btn.unlocked::after {
            content: "GO! ➔";
            position: absolute;
            bottom: 10px;
            right: 12px;
            font-family: 'Changa One', sans-serif;
            font-size: 0.95rem;
            opacity: 0;
            transform: translateX(-10px);
            transition: all 0.25s ease;
        }

        .menu-btn.unlocked:hover::after {
            opacity: 1;
            transform: translateX(0);
        }

        .menu-btn.locked {
            background: var(--locked-bg);
            border-color: var(--vandyke);
            color: var(--locked-text);
            box-shadow: 4px 4px 0px var(--vandyke);
            cursor: not-allowed;
            opacity: 0.82;
        }

        .menu-btn.locked .btn-tag { color: #786f67; }
        .menu-btn.locked .lock-icon { font-size: 1.25rem; transition: transform 0.3s ease; }

        .menu-btn.locked:hover {
            transform: translateY(-2px);
            background: #d0c9c2;
            box-shadow: 6px 6px 0px var(--vandyke);
            color: var(--vandyke);
        }

        .menu-btn.locked:hover .lock-icon {
            animation: lockShake 0.4s ease-in-out infinite alternate;
        }

        .menu-btn.locked::before {
            content: "LOCKED";
            position: absolute;
            bottom: 8px;
            right: 10px;
            font-family: 'Press Start 2P', monospace;
            font-size: 0.55rem;
            color: var(--vandyke);
            opacity: 0.5;
        }

        @keyframes lockShake {
            0% { transform: rotate(-12deg) scale(1.15); }
            100% { transform: rotate(12deg) scale(1.15); }
        }

        /* ==========================================
           MEME GENERATOR MODAL STYLING
           ========================================== */
        .font-retro-title { font-family: 'Bebas Neue', cursive; letter-spacing: 2px; }
        .font-meme { font-family: 'Anton', 'Impact', sans-serif; text-transform: uppercase; letter-spacing: 1px; }

        .retro-box-shadow { box-shadow: 6px 6px 0px var(--retro-black); }
        .retro-button-shadow {
            box-shadow: 4px 4px 0px var(--retro-black);
            transition: all 0.15s ease-in-out;
        }
        .retro-button-shadow:hover {
            transform: translate(-2px, -2px);
            box-shadow: 6px 6px 0px var(--retro-black);
        }
        .retro-button-shadow:active {
            transform: translate(2px, 2px);
            box-shadow: 2px 2px 0px var(--retro-black);
        }

        .meme-text-stroke {
            color: #FFFFFF;
            -webkit-text-stroke: 2px var(--retro-black);
            text-shadow: 
                3px 3px 0 var(--retro-black),
                -3px -3px 0 var(--retro-black),
                3px -3px 0 var(--retro-black),
                -3px 3px 0 var(--retro-black),
                0px 3px 0 var(--retro-black),
                0px -3px 0 var(--retro-black),
                3px 0px 0 var(--retro-black),
                -3px 0px 0 var(--retro-black),
                4px 4px 8px rgba(0,0,0,0.6);
            line-height: 1.1;
            word-break: break-word;
        }

        input[type=range] {
            -webkit-appearance: none;
            width: 100%;
            background: #E5E7EB;
            height: 10px;
            border-radius: 5px;
            border: 2px solid var(--retro-black);
        }
        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 22px;
            width: 22px;
            border-radius: 50%;
            background: var(--butter-yellow);
            border: 2px solid var(--retro-black);
            cursor: pointer;
            box-shadow: 2px 2px 0px var(--retro-black);
        }

        @media (max-width: 900px) {
            .menu-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
        }

        @media (max-width: 540px) {
            body { padding: 20px 12px; }
            .profile-card { padding: 20px 15px; margin-bottom: 25px; }
            .profile-name { font-size: 1.9rem; }
            .menu-grid { grid-template-columns: 1fr; gap: 12px; }
            .menu-btn { min-height: 90px; padding: 14px; }
            .btn-title { font-size: 1rem; }
        }
    </style>
</head>
<body>

    <!-- 作品集主畫面 -->
    <div class="container">
        <!-- 畫面正中央大頭貼與名字區塊 -->
        <header class="profile-card">
            <div class="avatar-wrapper">
                <span class="badge-sticker">PLAYER 1</span>
                <img src="https://picsum.photos/seed/retro-avatar/300/300" alt="大頭貼" class="avatar-img">
            </div>
            
            <h1 class="profile-name">YOUR NAME</h1>
            <div class="profile-subtitle">WEB DEV QUEST</div>

            <div class="quest-status">
                <span>QUEST PROGRESS:</span>
                <div class="progress-bar">
                    <div class="progress-fill"></div>
                </div>
                <span>3 / 16</span>
            </div>
        </header>

        <!-- 16 個按鈕選單 -->
        <main class="menu-grid">
            
            <!-- 按鈕 1 -->
            <a href="w1/index.html" class="menu-btn unlocked btn-1">
                <div class="btn-tag">
                    <span>STAGE 01</span>
                    <span>★ OPEN</span>
                </div>
                <div class="btn-title">Week 1-數位名片</div>
            </a>

            <!-- 按鈕 2 -->
            <a href="w2/index.html" class="menu-btn unlocked btn-2">
                <div class="btn-tag">
                    <span>STAGE 02</span>
                    <span>★ OPEN</span>
                </div>
                <div class="btn-title">Week 2-今天吃甚麼？</div>
            </a>

            <!-- 按鈕 3：點擊直接開啟 Modal 跳窗 -->
            <button onclick="openMemeModal()" class="menu-btn unlocked btn-3 text-left">
                <div class="btn-tag">
                    <span>STAGE 03</span>
                    <span>★ OPEN</span>
                </div>
                <div class="btn-title">Week 3-迷因產生器</div>
            </button>

            <!-- 按鈕 4 ~ 16 (未解鎖) -->
            <div class="menu-btn locked"><div class="btn-tag"><span>STAGE 04</span><span class="lock-icon">🔒</span></div><div class="btn-title">Week 4-未解鎖任務</div></div>
            <div class="menu-btn locked"><div class="btn-tag"><span>STAGE 05</span><span class="lock-icon">🔒</span></div><div class="btn-title">Week 5-未解鎖任務</div></div>
            <div class="menu-btn locked"><div class="btn-tag"><span>STAGE 06</span><span class="lock-icon">🔒</span></div><div class="btn-title">Week 6-未解鎖任務</div></div>
            <div class="menu-btn locked"><div class="btn-tag"><span>STAGE 07</span><span class="lock-icon">🔒</span></div><div class="btn-title">Week 7-未解鎖任務</div></div>
            <div class="menu-btn locked"><div class="btn-tag"><span>STAGE 08</span><span class="lock-icon">🔒</span></div><div class="btn-title">Week 8-未解鎖任務</div></div>
            <div class="menu-btn locked"><div class="btn-tag"><span>STAGE 09</span><span class="lock-icon">🔒</span></div><div class="btn-title">Week 9-期中作品展</div></div>
            <div class="menu-btn locked"><div class="btn-tag"><span>STAGE 10</span><span class="lock-icon">🔒</span></div><div class="btn-title">Week 10-未解鎖任務</div></div>
            <div class="menu-btn locked"><div class="btn-tag"><span>STAGE 11</span><span class="lock-icon">🔒</span></div><div class="btn-title">Week 11-未解鎖任務</div></div>
            <div class="menu-btn locked"><div class="btn-tag"><span>STAGE 12</span><span class="lock-icon">🔒</span></div><div class="btn-title">Week 12-未解鎖任務</div></div>
            <div class="menu-btn locked"><div class="btn-tag"><span>STAGE 13</span><span class="lock-icon">🔒</span></div><div class="btn-title">Week 13-未解鎖任務</div></div>
            <div class="menu-btn locked"><div class="btn-tag"><span>STAGE 14</span><span class="lock-icon">🔒</span></div><div class="btn-title">Week 14-未解鎖任務</div></div>
            <div class="menu-btn locked"><div class="btn-tag"><span>STAGE 15</span><span class="lock-icon">🔒</span></div><div class="btn-title">Week 15-未解鎖任務</div></div>
            <div class="menu-btn locked"><div class="btn-tag"><span>STAGE 16</span><span class="lock-icon">🔒</span></div><div class="btn-title">Week 16-期末專題</div></div>

        </main>
    </div>


    <!-- ==========================================
         STAGE 03 迷因產生器 (MODAL 互動跳窗)
         ========================================== -->
    <div id="meme-modal" class="fixed inset-0 bg-black/70 z-50 hidden flex items-center justify-center p-4 overflow-y-auto">
        
        <div class="bg-[#F6F6F6] border-4 border-[#1A1A1A] rounded-2xl max-w-5xl w-full max-h-[90vh] overflow-y-auto p-4 md:p-8 relative retro-box-shadow my-auto">
            
            <!-- 關閉按鈕 -->
            <button onclick="closeMemeModal()" class="absolute top-4 right-4 bg-red-400 hover:bg-red-500 text-white font-bold px-3 py-1 rounded-lg border-2 border-[#1A1A1A] retro-button-shadow z-10">
                ✕ CLOSE
            </button>

            <!-- 迷因產生器 Header -->
            <header class="text-center mb-6 pt-2">
                <div class="inline-block bg-[#EFDE9C] border-4 border-[#1A1A1A] px-6 py-2 rounded-xl retro-box-shadow transform -rotate-1">
                    <span class="bg-[#727272] text-white text-xs font-bold uppercase tracking-widest px-2 py-0.5 rounded border border-[#1A1A1A] mr-2">STAGE 03</span>
                    <h2 class="text-3xl md:text-5xl font-retro-title font-black text-[#1A1A1A] inline-block tracking-wide">
                        VINTAGE MEME FACTORY
                    </h2>
                </div>
                <p class="mt-2 text-xs md:text-sm font-semibold text-[#727272]">美式復古迷因圖產生器</p>
            </header>

            <!-- 主內容區塊 (左右雙欄 / 上下疊加) -->
            <main class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                
                <!-- 左側控制面板 -->
                <section class="lg:col-span-5 bg-white border-4 border-[#1A1A1A] rounded-2xl p-5 retro-box-shadow space-y-4">
                    <div class="border-b-4 border-[#1A1A1A] pb-2 flex justify-between items-center">
                        <h3 class="text-xl font-retro-title font-bold text-[#1A1A1A]">CONTROLS</h3>
                        <span class="text-xs bg-[#EFDE9C] border-2 border-[#1A1A1A] px-2 py-0.5 rounded font-bold">STEP BY STEP</span>
                    </div>

                    <!-- 1. 上傳圖片 -->
                    <div class="space-y-1">
                        <label class="block text-xs font-extrabold text-[#1A1A1A] uppercase">📷 1. 上傳迷因底圖</label>
                        <input type="file" id="image-upload" accept="image/*" class="hidden" onchange="handleImageUpload(event)" />
                        <label for="image-upload" class="flex items-center justify-center w-full p-3 border-2 border-dashed border-[#727272] hover:border-[#1A1A1A] bg-[#F6F6F6] hover:bg-[#EFDE9C]/30 rounded-xl cursor-pointer font-bold text-xs text-[#727272] hover:text-[#1A1A1A]">
                            Click to Upload Image
                        </label>
                    </div>

                    <!-- 2. 輸入文字 -->
                    <div class="space-y-3">
                        <div>
                            <label class="block text-xs font-extrabold text-[#1A1A1A] uppercase mb-1">✏️ 上方文字 (Top Text)</label>
                            <input type="text" id="top-text-input" value="WHEN YOU CODE IN ONE FILE" class="w-full px-3 py-1.5 bg-[#F6F6F6] border-2 border-[#1A1A1A] rounded-lg font-bold text-sm focus:outline-none focus:ring-2 focus:ring-[#EFDE9C]" oninput="updateMemeText()" />
                        </div>
                        <div>
                            <label class="block text-xs font-extrabold text-[#1A1A1A] uppercase mb-1">✏️ 下方文字 (Bottom Text)</label>
                            <input type="text" id="bottom-text-input" value="AND IT WORKS PERFECTLY" class="w-full px-3 py-1.5 bg-[#F6F6F6] border-2 border-[#1A1A1A] rounded-lg font-bold text-sm focus:outline-none focus:ring-2 focus:ring-[#EFDE9C]" oninput="updateMemeText()" />
                        </div>
                    </div>

                    <!-- 3. 滑桿參數控制 -->
                    <div class="space-y-3 pt-2 border-t-2 border-dashed border-[#727272]">
                        <div>
                            <div class="flex justify-between text-xs font-black text-[#1A1A1A] mb-1">
                                <span>🔤 字體大小</span><span id="font-size-val">36px</span>
                            </div>
                            <input type="range" id="font-size-slider" min="18" max="72" value="36" oninput="updateMemeStyles()" />
                        </div>
                        <div>
                            <div class="flex justify-between text-xs font-black text-[#1A1A1A] mb-1">
                                <span>⬆️ 上方文字位置</span><span id="top-pos-val">5%</span>
                            </div>
                            <input type="range" id="top-pos-slider" min="0" max="40" value="5" oninput="updateMemeStyles()" />
                        </div>
                        <div>
                            <div class="flex justify-between text-xs font-black text-[#1A1A1A] mb-1">
                                <span>⬇️ 下方文字位置</span><span id="bottom-pos-val">5%</span>
                            </div>
                            <input type="range" id="bottom-pos-slider" min="0" max="40" value="5" oninput="updateMemeStyles()" />
                        </div>
                    </div>

                    <!-- 4. 下載按鈕 -->
                    <div class="pt-2">
                        <button onclick="downloadMeme(event)" class="w-full py-3 bg-[#EFDE9C] hover:bg-[#ebd37d] text-[#1A1A1A] font-black text-base border-3 border-[#1A1A1A] rounded-xl retro-button-shadow flex items-center justify-center space-x-2 cursor-pointer">
                            <span>DOWNLOAD MEME (下載迷因)</span>
                        </button>
                    </div>
                </section>

                <!-- 右側即時預覽區 -->
                <section class="lg:col-span-7 flex flex-col items-center">
                    <div class="w-full bg-white border-4 border-[#1A1A1A] rounded-2xl p-4 retro-box-shadow">
                        <div class="flex justify-between items-center mb-3 pb-1 border-b-2 border-[#1A1A1A]">
                            <span class="text-xs font-black bg-[#1A1A1A] text-white px-2 py-0.5 rounded">LIVE PREVIEW</span>
                            <span class="text-xs font-bold text-[#727272]">即時預覽區</span>
                        </div>

                        <div id="meme-preview" class="relative w-full aspect-square md:min-h-[360px] max-h-[480px] bg-[#F6F6F6] border-4 border-[#1A1A1A] rounded-xl overflow-hidden flex items-center justify-center select-none">
                            <img id="meme-image" src="https://placehold.co/600x600/727272/FFFFFF?text=UPLOAD+YOUR+IMAGE" alt="Meme Background" class="w-full h-full object-contain pointer-events-none" />
                            <div id="meme-top-text" class="absolute top-5 left-0 right-0 px-4 text-center font-meme meme-text-stroke pointer-events-none" style="font-size: 36px;">WHEN YOU CODE IN ONE FILE</div>
                            <div id="meme-bottom-text" class="absolute bottom-5 left-0 right-0 px-4 text-center font-meme meme-text-stroke pointer-events-none" style="font-size: 36px;">AND IT WORKS PERFECTLY</div>
                        </div>
                    </div>
                </section>

            </main>
        </div>
    </div>


    <!-- ==========================================
         JAVASCRIPT 邏輯處理
         ========================================== -->
    <script>
        // 開啟與關閉 Modal 視窗功能
        function openMemeModal() {
            document.getElementById('meme-modal').classList.remove('hidden');
            updateMemeStyles();
            updateMemeText();
        }

        function closeMemeModal() {
            document.getElementById('meme-modal').classList.add('hidden');
        }

        // 圖片上傳預覽 (Base64)
        function handleImageUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('meme-image').src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        }

        // 即時更新文字
        function updateMemeText() {
            const topInput = document.getElementById('top-text-input').value;
            const bottomInput = document.getElementById('bottom-text-input').value;
            document.getElementById('meme-top-text').innerText = topInput;
            document.getElementById('meme-bottom-text').innerText = bottomInput;
        }

        // 即時更新樣式與滑桿數值
        function updateMemeStyles() {
            const fontSize = document.getElementById('font-size-slider').value;
            const topPos = document.getElementById('top-pos-slider').value;
            const bottomPos = document.getElementById('bottom-pos-slider').value;

            document.getElementById('font-size-val').innerText = fontSize + 'px';
            document.getElementById('top-pos-val').innerText = topPos + '%';
            document.getElementById('bottom-pos-val').innerText = bottomPos + '%';

            const topTextElem = document.getElementById('meme-top-text');
            const bottomTextElem = document.getElementById('meme-bottom-text');

            topTextElem.style.fontSize = fontSize + 'px';
            bottomTextElem.style.fontSize = fontSize + 'px';
            topTextElem.style.top = topPos + '%';
            bottomTextElem.style.bottom = bottomPos + '%';
        }

        // html2canvas 一鍵繪製與下載迷因
        function downloadMeme(event) {
            const memeContainer = document.getElementById('meme-preview');
            const downloadBtn = event.currentTarget;
            const originalBtnText = downloadBtn.innerHTML;

            downloadBtn.innerHTML = '<span>⏳ 產生中...</span>';
            downloadBtn.disabled = true;

            html2canvas(memeContainer, {
                scale: 2,
                useCORS: true,
                backgroundColor: null
            }).then(canvas => {
                const link = document.createElement('a');
                link.download = 'my-vintage-meme.png';
                link.href = canvas.toDataURL('image/png');
                link.click();

                downloadBtn.innerHTML = originalBtnText;
                downloadBtn.disabled = false;
            }).catch(err => {
                console.error('下載失敗:', err);
                downloadBtn.innerHTML = originalBtnText;
                downloadBtn.disabled = false;
            });
        }
    </script>

</body>
</html>
